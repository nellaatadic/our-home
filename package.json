{
  "name": "our-home",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.12.2"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file-if-exists=.env server/dev-server.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx --env-file-if-exists=.env server/migrate-cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:dev": "tsx --env-file-if-exists=.env scripts/seed-dev.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@hono/node-server": "^2.1.9",
    "@netlify/blobs": "^11.1.9",
    "@netlify/database": "^2.0.3",
    "@netlify/functions": "^6.1.1",
    "chrono-node": "^2.10.3",
    "hono": "^4.13.19",
    "lucide-react": "^1.75.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "jsdom": "^31.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
