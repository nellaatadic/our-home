# ---- Database -------------------------------------------------------------
# On Netlify, Netlify Database injects NETLIFY_DB_URL automatically; leave
# DATABASE_URL unset there. Locally, point at any Postgres 15+.
DATABASE_URL=

# ---- Security -------------------------------------------------------------
# 32 random bytes, base64. Encrypts Google OAuth tokens at rest.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# first-user-only (default) | invite-only | open
SIGNUP_MODE=

# ---- App URL --------------------------------------------------------------
# Public origin, used for invite links and the Google OAuth redirect.
APP_URL=

# ---- Google Calendar (optional) -------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to ${APP_URL}/api/google/callback
GOOGLE_REDIRECT_URI=

# ---- AI: text-to-event and receipt reading (optional) ---------------------
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5
ANTHROPIC_MODEL=
# Set to "off" to disable AI even when a key is present
AI_FEATURES=

# ---- Storage (optional) ---------------------------------------------------
# netlify (default on Netlify) | fs (default locally)
STORAGE_DRIVER=
STORAGE_DIR=
