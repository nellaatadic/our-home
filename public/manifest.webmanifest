{
  "name": "OUR HOME",
  "short_name": "OUR HOME",
  "description": "Our household: lists, plans, a board and one ongoing chat.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f6f2ea",
